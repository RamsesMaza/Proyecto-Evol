generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  SALES
  TI
  MARKETING
  AUDITOR
}

enum LeadStatus {
  nuevo
  contactado
  interesado
  en_negociacion
  convertido
  perdido
}

enum LeadPriority {
  baja
  media
  alta
  urgente
}

enum CampaignStatus {
  borrador
  activa
  pausada
  finalizada
  cancelada
}

enum CampaignType {
  email
  sms
  redes
  evento
  otro
}

model User {
  id                Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String   @unique
  phone             String?
  company           String?
  password          String
  role              Role     @default(USER)
  status            String   @default("nuevo")
  isFavorite        Boolean  @default(false)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorMethod   String?  @default("email")
  twoFactorSecret   String?
  phoneVerified     Boolean  @default(false)
  googleId          String?  @unique
  googleAvatar      String?
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ticketsCreated  SupportTicket[] @relation("TicketCreator")
  ticketsAssigned SupportTicket[] @relation("TicketAssignee")
  sessions        UserSession[]
  assignedLeads     Lead[]          @relation("LeadAssignee")
  assignedCampaigns Campaign[]      @relation("CampaignAssignee")
  leadActivities    LeadActivity[]  @relation("ActivityPerformer")
  createdSegments   Segment[]       @relation("SegmentCreator")
  segmentMemberships SegmentMember[]
  createdCertificates Certificate[] @relation("CertificateCreator")
  certificates        Certificate[] @relation("CertificateOwner")
  createdCourses      Course[] @relation("CourseCreator")
  enrollments         CourseEnrollment[]
  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")

  @@index([status])
  @@index([role])
}

model OtpCode {
  id          Int       @id @default(autoincrement())
  email       String?
  phone       String?
  userId      Int?
  code        String
  purpose     String    @default("password_reset")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
  @@index([phone, purpose])
  @@index([userId, purpose])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id             Int       @id @default(autoincrement())
  title          String
  name           String
  description    String
  fullDescription String?   @db.Text
  price          Float     @default(0)
  oldPrice       Float?
  categoryId     Int
  category       Category  @relation(fields: [categoryId], references: [id])
  image          String?
  // @deprecated Use ProductImage table
  images         String?   @db.Text
  stock          Int       @default(0)
  isNew          Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  isOffer        Boolean   @default(false)
  rating         Float     @default(0)
  reviewCount    Int       @default(0)
  // @deprecated Use ProductSpec table
  specs          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviews        Review[]
  orderItems     OrderItem[]
  productImages  ProductImage[]
  productSpecs   ProductSpec[]

  @@index([categoryId])
  @@index([title])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userName  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductSpec {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int?
  customerName   String
  customerEmail  String
  customerPhone  String?
  customerAddress String?
  customerCity   String?
  customerZip    String?
  shippingMethod String      @default("delivery")
  paymentMethod  String
  paymentDetail  String?     @db.Text
  paymentStatus  String      @default("pending")
  status         String      @default("pending")
  subtotal       Float       @default(0)
  tax            Float       @default(0)
  shipping       Float       @default(0)
  discount       Float       @default(0)
  couponCode     String?
  total          Float       @default(0)
  notes          String?
  billingType    String?
  billingRuc     String?
  billingName    String?
  billingAddress String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Float

  @@index([orderId])
  @@index([productId])
}

enum CotizacionEstado {
  pendiente
  aprobada
  rechazada
  expirada
  revision
}

model Cotizacion {
  id             Int                 @id @default(autoincrement())
  codigo         String              @unique
  clienteId      Int?
  clienteNombre  String
  clienteEmail   String
  clientePhone   String?
  clienteCompany String?
  vendedorId     Int?
  vendedorNombre String?
  fecha          DateTime            @default(now())
  vencimiento    DateTime
  estado         CotizacionEstado    @default(pendiente)
  subtotal       Float               @default(0)
  descuento      Float               @default(0)
  impuesto       Float               @default(0)
  total          Float               @default(0)
  notas          String?             @db.Text
  terminos       String?             @db.Text
  metodoPago     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          CotizacionItem[]
  actividad      CotizacionActividad[]

  @@index([codigo])
  @@index([clienteId])
  @@index([estado])
  @@index([fecha])
}

model CotizacionItem {
  id           Int         @id @default(autoincrement())
  cotizacionId Int
  cotizacion   Cotizacion  @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto     String
  descripcion  String?
  cantidad     Int         @default(1)
  precioUnit   Float       @default(0)
  descuento    Float       @default(0)
  total        Float       @default(0)

  @@index([cotizacionId])
}

model CotizacionActividad {
  id           Int         @id @default(autoincrement())
  cotizacionId Int
  cotizacion   Cotizacion  @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  tipo         String
  descripcion  String
  usuario      String?
  fecha        DateTime    @default(now())

  @@index([cotizacionId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  role         String
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  userEmail   String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  description String?
  ipAddress   String?
  oldValues   String?  @db.Text
  newValues   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  status      String   @default("abierto")
  priority    String   @default("media")
  createdById Int?
  createdBy   User?    @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId Int?
  assignedTo  User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  resolution  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assignedToId])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  userId    Int?
  ipAddress String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  token        String   @db.VarChar(2048)
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int?
  type      String    @default("info")
  title     String
  message   String?   @db.Text
  icon      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          Int         @id @default(autoincrement())
  campaignId  Int?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])
  name        String
  email       String?
  phone       String?
  company     String?
  position    String?
  source      String      @default("web")
  status      LeadStatus  @default(nuevo)
  priority    LeadPriority @default(media)
  assignedTo  Int?
  assignedUser User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  notes       String?     @db.Text
  observations String?    @db.Text
  contactedAt DateTime?
  convertedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  activities  LeadActivity[]

  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([campaignId])
  @@index([email])
}

model LeadActivity {
  id          Int      @id @default(autoincrement())
  leadId      Int
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   @default("nota")
  description String
  performedBy Int?
  performedUser User?  @relation("ActivityPerformer", fields: [performedBy], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model Campaign {
  id          Int            @id @default(autoincrement())
  name        String
  description String?        @db.Text
  objective   String?
  budget      Float          @default(0)
  spent       Float          @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus @default(borrador)
  type        CampaignType   @default(otro)
  assignedTo  Int?
  assignedUser User?         @relation("CampaignAssignee", fields: [assignedTo], references: [id])
  leads       Lead[]
  results     CampaignResult[]
  emailCampaigns EmailCampaign[]
  smsCampaigns   SmsCampaign[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([type])
  @@index([assignedTo])
}

model CampaignResult {
  id             Int      @id @default(autoincrement())
  campaignId     Int
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadsGenerated Int      @default(0)
  leadsConverted Int      @default(0)
  revenue        Float    @default(0)
  roi            Float    @default(0)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  opens          Int      @default(0)
  recordedAt     DateTime @default(now())

  @@index([campaignId])
}

model EmailCampaign {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String    @db.Text
  template    String?
  status      String    @default("borrador")
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int       @default(0)
  opened      Int       @default(0)
  clicked     Int       @default(0)
  converted   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
}

model SmsCampaign {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  message     String    @db.Text
  provider    String    @default("twilio")
  status      String    @default("borrador")
  scheduledAt DateTime?
  sentAt      DateTime?
  sent        Int       @default(0)
  delivered   Int       @default(0)
  responded   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
}

model Segment {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  criteria    String?  @db.Text
  createdBy   Int?
  creator     User?    @relation("SegmentCreator", fields: [createdBy], references: [id])
  members     SegmentMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SegmentMember {
  id        Int      @id @default(autoincrement())
  segmentId Int
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([segmentId, userId])
  @@index([segmentId])
  @@index([userId])
}

model Certificate {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("CertificateOwner", fields: [userId], references: [id])
  title        String
  description  String?  @db.Text
  issuer       String   @default("ACS Academy")
  issueDate    DateTime @default(now())
  expiryDate   DateTime?
  imageUrl     String?  @db.Text
  course       String?
  hours        Int?
  credentialId String   @unique
  createdBy    Int?
  creator      User?    @relation("CertificateCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdBy])
  @@index([credentialId])
}

enum CourseLevel {
  basico
  intermedio
  avanzado
}

model Course {
  id          Int            @id @default(autoincrement())
  title       String
  description String?        @db.Text
  category    String?
  level       CourseLevel    @default(basico)
  imageUrl    String?
  duration    Int?
  createdBy   Int?
  creator     User?          @relation("CourseCreator", fields: [createdBy], references: [id])
  published   Boolean        @default(false)
  visibleToRoles String?     @default("[]")
  visibleToUsers String?     @default("[]")
  modules     CourseModule[]
  enrollments CourseEnrollment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdBy])
  @@index([published])
}

model CourseModule {
  id          Int             @id @default(autoincrement())
  courseId     Int
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int             @default(0)
  materials   CourseMaterial[]
  createdAt   DateTime        @default(now())

  @@index([courseId])
}

model CourseMaterial {
  id         Int           @id @default(autoincrement())
  moduleId   Int
  module     CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  type       String        @default("pdf")
  fileUrl    String?
  embedUrl   String?
  duration   Int?
  createdAt  DateTime      @default(now())

  @@index([moduleId])
}

model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  progress  Float    @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model Message {
  id        Int      @id @default(autoincrement())
  senderId  Int
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId Int?
  receiver  User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject   String?
  body      String   @db.Text
  read      Boolean  @default(false)
  parentId  Int?
  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([parentId])
}
